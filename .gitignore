# ! --- 1. Игнорируем абсолютно всё по умолчанию
# ! --------------------------------------------
*

# ! --- 2. Разрешаем Git наблюдать за любыми папками
# ! ------------------------------------------------
!*/
!**/

# ! --- 3. Разрешаем проверять только конкретные расширения
# ! -------------------------------------------------------
# * GIT FILES
!**/*.gitkeep
!**/*.gitignore
!**/*.gitattributes

# * BASH | BAT
!**/*.sh
!**/*.bat

# * SERVICE FILES
!**/*.browserslistrc
!**/*.editorconfig
!**/*.npmrc

# * IGNORE FILES
!**/*.dockerignore
!**/*.prettierignore
!**/*.stylelintignore

# * DOCKER FILES
!**/Dockerfile*

# * PYTHON | POETRY
!**/*.py

!**/*.toml
!**/*.lock

# * CSS | SCSS | SASS
!**/*.css
!**/*.scss
!**/*.sass

# * JS | TS
!**/*.js
!**/*.cjs
!**/*.mjs
!**/*.ts
!**/*.cts
!**/*.mts

# * GULP
!gulpfile.js
!**/gulp/**/*.js

# * HTML | NUNJUCKS
!**/*.html
!**/*.nj
!**/*.njk
!**/*.nunjucks

# * JSON | YAML
!**/*.json
!**/*.webmanifest

!**/*.yml
!**/*.yaml

# * XML | SVG
!**/*.xml
!**/*.svg

# * MEDIA
!**/*.ico
!**/*.gif

!**/*.png
!**/*.jpg
!**/*.jpeg
!**/*.avif
!**/*.webp

!**/*.mp3
!**/*.mp4
!**/*.webm

# * 3D FILES
!**/*.glb

# * FONTS
!**/*.eot
!**/*.otf
!**/*.ttf
!**/*.woff
!**/*.woff2

# * MARKDOWN | LICENSE
!**/*.md
!**/LICENSE

# * HUSKY
!**/.husky/*

# * LOCALES
!**/*.mo
!**/*.po

# * TEMPLATES FILES
!**/*.template
!**/*.tmpl

# * DEPLOY FILES | NGINX | APACHE
!**/vhost.d/default
!**/*.conf

!**/*.htaccess

# * OTHER
!**/*.txt

# * MAPS
# !**/*.map

# ! --- 4. Папки и подпапки под запретом
# ! ------------------------------------
**/.husky/_/

**/node_modules/
# **/vendors/

**/out/
**/dist/
**/build/
**/public/

**/archive/

**/backup/
**/old/

**/debug__critical_css__screenshots/

# ! --- 5. Файлы под запретом
# ! -------------------------
out.txt

# * ENV FILES
*.dev

*.staging
*.staging.db
*.staging.proxy-companion

*.prod
*.prod.db
*.prod.proxy-companion

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
