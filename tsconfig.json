{
    // Visit https://aka.ms/tsconfig to read more about this file
    "compilerOptions": {
        "types": ["node"],

        // "rootDir": "./src/ts", // исходники TS
        // "outDir": "./dist/js", // куда компилируем JS

        "target": "es2020", // таргет - es2020
        "module": "esnext", // современный модульный синтаксис

        "lib": ["DOM", "ES2018"], // библиотеки для TS

        "strict": true, // включить строгий режим для безопасного кода
        "noImplicitAny": true, // запрещает неявный any
        "skipLibCheck": true, // пропуск проверки типов библиотек

        "forceConsistentCasingInFileNames": true,

        "esModuleInterop": true, // чтобы корректно импортировать CommonJS модули
        "allowSyntheticDefaultImports": true,

        "sourceMap": true, // генерировать sourcemap
        "removeComments": true, // удалять комментарии из JS
        "incremental": true, // ускоренная компиляция

        // "baseUrl": ".", // deprecated
        "paths": {
            "modules/*": ["./src/ts/modules/*"]
        }
    },
    "include": ["src/ts/**/*.ts", "tests/**/*.ts", "playwright.config.ts"], // какие файлы компилировать
    "exclude": ["node_modules", "debug__critical_css__screenshots"] // что игнорировать
}
