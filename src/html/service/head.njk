<!-- ! DO NOT REMOVE THIS NUNJUCKS IMPORTS | PART OF GULP BUILD !!! --->
{% from "macros/macro__current_page__get_full_url.njk" import current_page__get_full_url with context %}
{% from "macros/macro__hreflang_meta_tags.njk" import hreflang_meta_tags with context %}
{% from "macros/macro__inline_script.njk" import inline_script %}

{% set current_page__full_url = current_page__get_full_url(current_page__page_name) %}

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <!-- ! 1. CRITICAL JS <head> SCRIPTS | START --->
    <!-- ! ------------------------------------- --->

    <!-- * 1. If JS supports -> enable JS classes - -->
    <script>
        document.documentElement.classList.remove('nojs')
        document.documentElement.classList.add('js')
    </script>

    <!-- * 2. Set current page name to <body> -->
    <script>
        const pageName =
            window.location.pathname
                .split('/')
                .pop()
                .replace(/\.[^/.]+$/, '') || 'home'
        document.documentElement.classList.add(`page-${pageName}`)
    </script>

    <!-- * 3. Choose saved color-scheme before render page -->
    <script>
        const stored = localStorage.getItem('theme')
        const system = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
        document.documentElement.setAttribute('data-theme', stored || system)
    </script>

    <!-- * 4. Inject inline avif/webp script polyfill | PLACE IT BEFORE ANY CSS FILES --->
    {{ inline_script('node_modules/gulp-web-images-css/plugin.js') }}

    <!-- ! 1. CRITICAL JS <head> SCRIPTS | END --->
    <!-- ! ----------------------------------- --->

    <!-- ! 2. PRELOAD CRITICAL ASSETS | START --->
    <!-- ! ---------------------------------- --->

    <link rel="preload" href="@fonts/Montserrat/Montserrat-VariableFont_wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="@fonts/Pattaya/Pattaya-Regular.woff2" as="font" type="font/woff2" crossorigin />

    <!-- ! 2. PRELOAD CRITICAL ASSETS | END --->
    <!-- ! -------------------------------- --->

    <!--! 3. CSS BLOCK | START --->
    <!--! -------------------- --->

    <!-- * 1. Inject inline critical-css --->
    <!-- ! DO NOT REMOVE THIS COMMENT !!! | CRITICAL CSS PLACEHOLDER --->

    <!-- * 2. Import vendors CSS --->
    <!-- empty --->

    <!-- ! DO NOT REMOVE THIS COMMENT !!! | INLINE CSS START | DISABLED BY DEFAULT --->
    <!-- * 3. Import my CSS --->
    <link rel="preload" href="@scss/main.scss" as="style" onload="this.onload=null;this.rel='stylesheet'" />

    <!-- * 3.1. Fallback (if JS disable) --->
    <noscript>
        <link rel="stylesheet" href="@scss/main.scss" />
    </noscript>
    <!-- ! DO NOT REMOVE THIS COMMENT !!! | INLINE CSS END --->

    <!--! 3. CSS BLOCK | END --->
    <!--! ------------------ --->

    <!--! 4. META TAGS | START --->
    <!--! -------------------- --->

    <!-- * BLOCK PHONE NUMBER, DATE, ADDRESS & EMAIL AS LINK DETECTION --->
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />

    <!-- ! DO NOT REMOVE THIS NUNJUCKS BLOCK !!! | PAGE LOCALE TAGS --->
    {{ hreflang_meta_tags(current_page__page_name) }}
    <!-- ! -------------------------------------------------------- --->

    <!-- * Page title --->
    <title>{{ current_page__head_content.title }}</title>

    <!-- * Page description & keywords --->
    <meta name="description" content="{{ current_page__head_content.description }}" />
    <meta name="keywords" content="{{ current_page__head_content.keywords }}" />

    <!-- * Authors --->
    <link rel="author" href="@meta/humans.txt" />

    <!-- * Page favicon --->
    <link rel="icon" type="image/svg+xml" href="@meta/favicon/favicon-dark.svg" media="(prefers-color-scheme: dark)" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="@meta/favicon/favicon.svg" media="(prefers-color-scheme: light)" sizes="any" />

    <link rel="icon" type="image/png" href="@meta/favicon/favicon-96x96.png" sizes="96x96" />

    <link rel="apple-touch-icon" href="@meta/favicon/apple-touch-icon.png" sizes="180x180" />
    <meta name="apple-mobile-web-app-title" content="{{ common.website_domain }}" />
    <link rel="manifest" href="@meta/favicon/site.webmanifest" />

    <link rel="shortcut icon" href="@meta/favicon/favicon.ico" sizes="32x32" />

    <!-- * Open Graph --->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="{{ i18n.current.ogLocale }}" />

    <meta property="og:url" content="{{ current_page__full_url }}" />
    <meta property="og:title" content="{{ current_page__head_content.title }}" />
    <meta property="og:description" content="{{ current_page__head_content.description }}" />

    <meta property="og:image" content="@images/open_graph/og_img.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ head.open_graph_img__alt }}" />

    <meta name="twitter:card" content="summary_large_image" />

    <!-- * Canonical tag | Improving search engine rankings --->
    <link rel="canonical" href="{{ current_page__full_url }}" />

    <!--! 4. META TAGS | END --->
    <!--! ------------------ --->

    <!-- ! 5. NON-CRITICAL (BASE) JS <head> SCRIPTS | START --->
    <!-- ! ------------------------------------------------ --->

    <!-- * 1. Add tabbing class to body if user move in page with tab button -->
    <script>
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Tab') {
                document.documentElement.classList.add('user-is-tabbing')
            }
        })
        document.addEventListener('pointerdown', () => {
            document.documentElement.classList.remove('user-is-tabbing')
        })
    </script>

    <!-- * 2. Other base non-inline JS scripts for <head> section -->
    {% include "service/scripts__preload.njk" %}

    <!-- ! 5. NON-CRITICAL (BASE) JS <head> SCRIPTS | END --->
    <!-- ! ---------------------------------------------- --->
</head>
