{% extends "base/base.njk" %}

<!-- ? название текущей страницы в домене --->
{% set current_page__page_name = 'fail' %}

<!-- ? передаем текстовые данные из файла переовдов *.json для <head> этой страницы -->
{% set current_page__head_content = fail.head %}

{% block content %}
    <div class="my-shadow-group">
        <section id="fail" class="my-server-response">
            <div class="container my-wrapper my-server-response__content">
                <h1 class="my-title my-title--server-response" data-variant="fail">
                    <span>{{ fail.main_content.heading }}</span>
                </h1>

                <h2 class="my-subtitle my-subtitle--server-response">{{ fail.main_content.subheading | nl2br }}</h2>

                <div class="my-default-button">
                    <a class="my-default-button__link" href="@page/index.njk#feedback-form">{{ fail.main_content.button_text }}</a>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
