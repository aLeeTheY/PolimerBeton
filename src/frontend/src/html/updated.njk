{% extends "base/base.njk" %}

<!-- ? название текущей страницы в домене --->
{% set current_page__page_name = 'updated' %}

<!-- ? передаем текстовые данные из файла переовдов *.json для 'head' этой страницы -->
{% set current_page__head_content = updated.head %}

{% block content %}
    <div class="my-shadow-group">
        <section id="updated" class="my-server-response">
            <div class="container my-wrapper my-server-response__content">
                <h1 class="my-title my-title--server-response" data-variant="updated">
                    <span>{{ updated.main_content.heading }}</span>
                </h1>

                <h2 class="my-subtitle my-subtitle--server-response">{{ updated.main_content.subheading }}</h2>
                <p class="my-subtitle my-subtitle--server-response">
                    {{ updated.main_content.available_attempts.label }}
                    {% if is_django_build %}
                        {% raw %}
                            {% if available_attempts is not None %}
                                {{ available_attempts }}
                            {% else %}
                                —
                            {% endif %}
                        {% endraw %}
                    {% else %}
                        {{ updated.main_content.available_attempts.demo_data }}
                    {% endif %}
                </p>

                <div class="my-default-button">
                    <a class="my-default-button__link" href="@page/index.njk#feedback-form">{{ updated.main_content.button_text }}</a>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
